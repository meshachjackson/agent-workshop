# Server-only. Use the production URL shown by your published n8n Webhook node.
NUXT_N8N_WEBHOOK_URL=
# Match the n8n Header Auth credential named X-Agent-Secret.
NUXT_N8N_WEBHOOK_SECRET=
# Total wait for all agents; timeout does not cancel an n8n execution.
NUXT_N8N_TIMEOUT_MS=120000
# OpenAI credentials belong in n8n, never in this app.
